# Banco (Supabase Postgres) — mesma URL usada pelo site atual
DATABASE_URL=

# Painel admin — OBRIGATÓRIOS. Sem eles o login fica desligado (não há mais senha padrão no código).
ADMIN_USER=
ADMIN_PASS=
# Segredo para assinar o login do admin: string aleatória com 16+ caracteres
JWT_SECRET=

# Supabase REST (usado só pelo /api/keepalive)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Livre
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://savingthrow.com.br/api/integrations/mercadolivre/callback

# Shopee (integração ainda em esboço)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=
SHOPEE_WEBHOOK_URL=

# Opcionais
NEXT_PUBLIC_SITE_URL=https://savingthrow.com.br
NEXT_PUBLIC_3D_BACKEND_URL=http://localhost:8000

# Login dos mestres (página Efeitos Sonoros). Se vazio, usa JWT_SECRET.
GM_SESSION_SECRET=
# Client ID do "Entrar com Google" (padrão: o mesmo já usado na página)
GOOGLE_CLIENT_ID=

# SEO: código de verificação do Google Search Console (só o valor de content="...")
GOOGLE_SITE_VERIFICATION=
