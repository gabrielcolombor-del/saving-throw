{
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 0 */3 * *"
    }
  ],
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
